# Runtime environment. Accepted values: development, test, production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Optional override. Defaults: development=debug, test=silent, production=info.
# LOG_LEVEL=debug

# Comma-separated exact browser origins. Wildcards are not accepted.
# Production requires at least one explicit origin.
FRONTEND_ORIGINS=http://localhost:5173

# Required in every environment. Generate 32 random bytes and encode them as
# unpadded base64url; this deliberately invalid placeholder prevents accidental use.
ACCESS_TOKEN_SECRET=replace-with-32-random-bytes-in-base64url
# Optional Google Sign-In OAuth client ID. Leave unset when Google auth is disabled.
# GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
# Independent HMAC key for password-reset codes and temporary reset tokens.
# Required in every environment; generate a different 32-byte base64url secret.
PASSWORD_RESET_SECRET=replace-with-a-different-32-byte-base64url-secret
# Transactional password-reset email. Test mode disables real delivery.
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM="CodeGym <security@example.com>"
# Short-lived access JWT (60-900 seconds). Default: 600.
ACCESS_TOKEN_TTL_SECONDS=600
# Absolute refresh-session lifetime (1-90 days). Default: 30 days.
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_IDLE_TIMEOUT_SECONDS=900

# MySQL 8.4 connection. Use a non-root runtime account and replace every
# placeholder locally. The application builds Prisma's URL internally.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=codegym
DB_USER=codegym
DB_PASSWORD=change-me
# Defaults to true in production and cannot be disabled there.
DB_SSL=false
