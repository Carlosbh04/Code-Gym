      "language": "javascript",
      "options": [
        {
          "id": "a",
          "text": "0|normal",
          "correct": true
        },
        {
          "id": "b",
          "text": "10|normal",
          "correct": false
        },
        {
          "id": "c",
          "text": "0|undefined",
          "correct": false
        }
      ],
      "errorLines": null,
      "errorType": null,
      "testCases": null,
      "expectedPatterns": null,
      "explanation": "El spread de usuario aparece después y puede sobrescribir limite incluso con 0.",
      "hints": [
        "Spread no ignora valores falsy.",
        "modo solo existe en defaults."
      ],
      "stepOrder": 1
    },
    {
      "id": "step-2",
      "type": "predict-output",
      "prompt": "¿Qué devuelve el parámetro destructurado cuando no se pasa argumento?",
      "code": "function idioma({ locale = 'es' } = {}) {\n  return locale;\n}\nconsole.log(idioma());",
      "language": "javascript",
      "options": [
        {
          "id": "a",
          "text": "es",
          "correct": true
        },
        {
          "id": "b",
          "text": "undefined",
          "correct": false
