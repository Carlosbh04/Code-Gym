        {
          "id": "c",
          "text": "TypeError",
          "correct": false
        }
      ],
      "errorLines": null,
      "errorType": null,
      "testCases": null,
      "expectedPatterns": null,
      "explanation": "El parámetro completo usa {} como default y después locale usa es.",
      "hints": [
        "Hay dos defaults distintos.",
        "Primero se resuelve el argumento de la función."
      ],
      "stepOrder": 2
    },
    {
      "id": "step-3",
      "type": "find-error",
      "prompt": "¿Por qué limites.max desaparece?",
      "code": "const base = { limites: { min: 1, max: 10 }, tema: 'claro' };\nconst cambios = { limites: { min: 3 } };\nconst final = { ...base, ...cambios };\nconsole.log(final);",
      "language": "javascript",
      "options": [
        {
          "id": "a",
          "text": "shallow",
          "correct": "el spread exterior reemplaza limites completo en lugar de fusionar sus propiedades"
        },
        {
          "id": "b",
          "text": "orden",
          "correct": "base siempre debería ir después de cambios"
        },
        {
          "id": "c",
          "text": "max",
          "correct": "max no puede almacenarse junto a min"
        }
      ],
      "errorLines": [
        3
      ],
      "errorType": "conceptual",
      "testCases": null,
      "expectedPatterns": null,
      "explanation": "Object spread es superficial. La propiedad limites de cambios reemplaza la referencia completa de base.",
      "hints": [
        "El spread no hace deep merge.",
        "Si quieres fusionar limites debes crear esa rama explícitamente."
      ],
      "stepOrder": 3
    },
    {
      "id": "step-4",
      "type": "fix-code",
      "prompt": "Corrige combinarConfig para fusionar el nivel superior y también la rama limites, sin mutar las entradas.",
      "code": "function combinarConfig(base, cambios) {\n  return { ...base, ...cambios };\n}",
      "language": "javascript",
      "options": null,
      "errorLines": null,
      "errorType": null,
      "testCases": [
        {
          "input": {
            "base": {
