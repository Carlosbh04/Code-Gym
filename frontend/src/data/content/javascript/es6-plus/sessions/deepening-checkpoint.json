          "correct": false
        },
        {
          "id": "c",
          "text": "false|user",
          "correct": false
        }
      ],
      "errorLines": null,
      "errorType": null,
      "testCases": null,
      "expectedPatterns": null,
      "explanation": "Cada escritura posterior tiene precedencia sobre la misma clave.",
